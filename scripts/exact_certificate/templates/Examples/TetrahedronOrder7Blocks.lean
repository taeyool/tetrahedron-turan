/-- The six-vertex stationarity numerator `3 * n1 - n2`. -/
def statNum (h : ℕ) : ℤ :=
  statTable.foldl (fun acc t =>
    if h.testBit t.1 then
      acc + (if h.testBit t.2.1 then 3 else 0)
        - (if h.testBit t.2.2.1 then 1 else 0)
        - (if h.testBit t.2.2.2.1 then 1 else 0)
        - (if h.testBit t.2.2.2.2 then 1 else 0)
    else acc) 0

/-- Number of hyperedges of a six-vertex mask. -/
def edgeCount (h : ℕ) : ℕ :=
  (List.range 20).foldl (fun acc i => if h.testBit i then acc + 1 else acc) 0

/-- The scale of the certificate coefficients. -/
def certScale : ℤ := 100000

/-- The stationarity multiplier. -/
def tauNum : ℤ := 1219077971869

/-- **The class number of a six-vertex class**, over the common
denominator `720 * certScale ^ 2`. -/
def classNum (h : ℕ) : ℤ :=
  36 * (edgeCount h : ℤ) * certScale * certScale
    + 4 * blockValue24 h + blockValue45 h
    + 12 * tauNum * statNum h

/-- The class numbers of the 964 representatives. -/
def classNums : Array ℤ := (h6Reps.map classNum).toArray

