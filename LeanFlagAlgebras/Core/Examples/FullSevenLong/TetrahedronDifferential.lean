/-! ## The vertex derivative of the edge density (the paper's (Dgrad)) -/

/-- `∂₁ρ = 3 (π¹ρ − d)` on the algebra: the hyperedge has three vertices and
the degree flag as its single rooting. -/
theorem partialVertex_edgeElt :
    partialVertex (σ₁ := vertexGraph.toModel) edgeElt
      = (3 : ℝ) • (upward (σ₁ := vertexGraph.toModel) edgeElt - degreeFlag) := by
  rw [edgeElt_eq_basis, partialVertex_basis, degreeFlag_eq_basis, muElt, muVec_edge]
  show ((3 : ℕ) : ℝ) • _ = (3 : ℝ) • _
  norm_num

/-- **(Dgrad)**: `⟦d · ∂₁ρ⟧₁ = 3 D` — the stationarity element is, up to the
factor `3`, the vertex derivative of the edge density tested against the
degree flag (Theorem 2.8(a) and `⟦d⟧₁ = ρ`). -/
theorem downward_degreeFlag_mul_partialVertex_edgeElt :
    downward (degreeFlag * partialVertex (σ₁ := vertexGraph.toModel) edgeElt)
      = (3 : ℝ) • degreeStationarity := by
  rw [partialVertex_edgeElt, mul_smul_comm, downward_smul, mul_sub, downward_sub,
    mul_comm degreeFlag (upward edgeElt), downward_upward_mul, downward_degreeFlag,
    degreeStationarity_eq]

/-! ## The chain's named statements are theorems -/

/-- **Every positive homomorphism of the tetrahedron-free theory is
realized** (the chain's named statement D2): Razborov's Theorem 3.3,
sampling direction. -/
theorem everyHomRealized : EveryHomRealized := fun φ => by
  obtain ⟨Gs, h⟩ := FlagAlgebras.Core.exists_realizedBy φ
  exact ⟨Gs, (realizedBy_iff φ Gs).mpr h⟩

/-- **An edge-density maximizer is degree-stationary** (the chain's named
statement M2d), through the differential method, with no realization
hypothesis: every homomorphism is realized. -/
theorem maximizerIsStationary : MaximizerIsStationary := fun φ hmax => by
  obtain ⟨Gs, hGs⟩ := everyHomRealized φ
  exact isDegreeStationary_of_maximizer φ Gs hGs hmax

/-- **Every positive homomorphism is below the certificate**, through the
chain's consumption of M2d. -/
theorem edge_le_certBound_all (ψ : PositiveHom TetraFree emptyType) :
    ψ edgeElt ≤ ((certBound : ℚ) : ℝ) := by
  obtain ⟨φmax, _, _, hmax, _⟩ := exists_realized_maximizer maxDensAntitone
  exact edge_le_certBound_forall maximizerIsStationary φmax hmax ψ

