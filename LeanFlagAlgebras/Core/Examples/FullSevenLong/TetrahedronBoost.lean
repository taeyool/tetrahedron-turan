        have h1 : (n : ℝ) ^ 4 * D₀ ≤ D₁ * D₀ :=
          mul_le_mul_of_nonneg_right hD₁ge hD₀nn
        have h2 : (n : ℝ) ^ 4 * D₁ ≤ D₀ * D₁ :=
          mul_le_mul_of_nonneg_right hD₀ge hD₁nn
        linarith
    _ = 258 * (D₀ * D₁) := by ring

/-! ## The boost -/

/-- **The clone boost is a theorem**: a genuinely negative stationarity
combination forces a degree gap beyond every codegree, and cloning the
large-degree vertex over the small one strictly gains edges at the same
size. -/
theorem finiteBoost : FiniteBoost := by
  intro ε hε
  obtain ⟨N₀, hN₀⟩ := exists_nat_gt (258 / ε)
  refine ⟨max N₀ 64, ?_⟩
  intro G hNle hstat
  obtain ⟨n, Gf⟩ := G
  obtain ⟨G₀, hG₀, hGeq⟩ := exists_sym3Graph_toFlag
    (fun (M : Model hypergraph3Sig (Fin n))
      (h : TetraFree.Mem M) => h.1) Gf
  subst hGeq
  have hn64 : 64 ≤ n := le_trans (le_max_right _ _) hNle
  have hnN₀ : N₀ ≤ n := le_trans (le_max_left _ _) hNle
  by_cases hgap : ∀ v w : Fin n,
      G₀.degree v ≤ G₀.degree w + (n - 2)
  · -- no gap anywhere: the deficit is impossible at this size
    exfalso
    have hstat' : statComb ⟨n, G₀.toFlag hG₀⟩ ≤ -ε := hstat
    rw [statComb_toFlag_eq G₀ hG₀ (by omega : 6 ≤ n)] at hstat'
    have hcount := noGap_count_bound G₀ hn64 hgap
    have hD₀pos : (0 : ℝ) < (pairChoose n 3 3 : ℝ) := by
      exact_mod_cast pairChoose_pos (show 3 + 3 ≤ n by omega)
    have hc5pos : (0 : ℝ) < (n.choose 5 : ℝ) := by
      exact_mod_cast Nat.choose_pos (show 5 ≤ n by omega)
    have hD₁pos : (0 : ℝ) < 30 * (n.choose 5 : ℝ) := by linarith
    have hprod : (0 : ℝ)
        < (pairChoose n 3 3 : ℝ) * (30 * (n.choose 5 : ℝ)) :=
      mul_pos hD₀pos hD₁pos
    -- clear denominators in the stationarity deficit
    have hΔ : ε * ((pairChoose n 3 3 : ℝ) * (30 * (n.choose 5 : ℝ)))
        ≤ (G₀.pairCountInter 1 : ℝ) * (pairChoose n 3 3 : ℝ)
          - (G₀.pairCountInter 0 : ℝ) * (30 * (n.choose 5 : ℝ)) := by
      have hmul := mul_le_mul_of_nonneg_right hstat' hprod.le
      have hfield : ((G₀.pairCountInter 0 : ℝ) / (pairChoose n 3 3 : ℝ)
            - (G₀.pairCountInter 1 : ℝ) / (30 * (n.choose 5 : ℝ)))
            * ((pairChoose n 3 3 : ℝ) * (30 * (n.choose 5 : ℝ)))
          = (G₀.pairCountInter 0 : ℝ) * (30 * (n.choose 5 : ℝ))
            - (G₀.pairCountInter 1 : ℝ) * (pairChoose n 3 3 : ℝ) := by
        field_simp
      rw [hfield] at hmul
      linarith [hmul]
    -- combine: `n·ε ≤ 258`, against `258/ε < N₀ ≤ n`
    have hnε : (n : ℝ) * ε ≤ 258 := by
      have h1 : (n : ℝ) * (ε * ((pairChoose n 3 3 : ℝ)
            * (30 * (n.choose 5 : ℝ))))
          ≤ (n : ℝ) * ((G₀.pairCountInter 1 : ℝ)
              * (pairChoose n 3 3 : ℝ)
            - (G₀.pairCountInter 0 : ℝ) * (30 * (n.choose 5 : ℝ))) :=
        mul_le_mul_of_nonneg_left hΔ (Nat.cast_nonneg _)
      have h2 := le_trans h1 hcount
      by_contra h258
      push_neg at h258
      have h3 := mul_lt_mul_of_pos_right h258 hprod
      nlinarith [h2, h3]
    have hgt : 258 / ε < (n : ℝ) :=
      lt_of_lt_of_le hN₀ (by exact_mod_cast hnN₀)
    rw [div_lt_iff₀ hε] at hgt
    linarith
  · -- a genuine gap: clone across it
    push_neg at hgap
    obtain ⟨u, w, hgap⟩ := hgap
    have huw : u ≠ w := by
      intro h
      rw [h] at hgap
      omega
    have hclone : G₀.edges.card < (G₀.cloneAt u w huw).edges.card := by
      refine G₀.card_cloneAt_gt huw ?_
      have hco := G₀.codegree_le huw
      show (G₀.edges.filter fun e => w ∈ e).card + G₀.codegree u w
        < (G₀.edges.filter fun e => u ∈ e).card
      have h1 : (G₀.edges.filter fun e => w ∈ e).card = G₀.degree w := rfl
      have h2 : (G₀.edges.filter fun e => u ∈ e).card = G₀.degree u := rfl
      omega
    refine ⟨(G₀.cloneAt u w huw).toFlag (cloneAt_mem huw hG₀), ?_⟩
    show edgeDens ⟨n, G₀.toFlag hG₀⟩
      < edgeDens ⟨n, (G₀.cloneAt u w huw).toFlag (cloneAt_mem huw hG₀)⟩
    rw [edgeDens_toFlag, edgeDens_toFlag]
    have hC : (0 : ℝ) < (n.choose 3 : ℝ) := by
      exact_mod_cast Nat.choose_pos (show 3 ≤ n by omega)
    have hlt : (G₀.edges.card : ℝ)
        < ((G₀.cloneAt u w huw).edges.card : ℝ) := by
      exact_mod_cast hclone
    rw [div_eq_mul_inv, div_eq_mul_inv]
    exact mul_lt_mul_of_pos_right hlt (inv_pos.mpr hC)

/-! ## The unconditional bound -/

/-- **The finite Turán density of the tetrahedron obeys the order-7
certificate bound, through the finite cloning boost**: no hypotheses
remain. -/
theorem turanDensity_le_certBound_finite :
    turanDensity ≤ ((certBound : ℚ) : ℝ) :=
  turanDensity_le_certBound maxDensAntitone finiteBoost

/-- The bound, numerically: below the published record `1123/2000`. -/
theorem turanDensity_lt_published_finite :
    turanDensity < (1123 / 2000 : ℝ) := by
  refine lt_of_le_of_lt turanDensity_le_certBound_finite ?_
  rw [certBound_cast]
  norm_num

/-- The elementary headline through the finite route: the Turán density of
the tetrahedron is at most the certificate value `312372062889819 / 560000000000000`. -/
theorem tetraTuranDensity_le_certValue_finite :
    tetraTuranDensity ≤ 312372062889819 / 560000000000000 := by
  rw [tetraTuranDensity_eq]
  exact turanDensity_le_certBound_finite.trans_eq certBound_cast

/-- The comparison form through the finite route. -/
theorem tetraTuranDensity_lt_published_finite :
    tetraTuranDensity < 1123 / 2000 := by
  rw [tetraTuranDensity_eq]
  exact turanDensity_lt_published_finite

end FlagAlgebras.Core.Tetrahedron.FullSevenLong
