      = 9 * (n.choose 3 * (n - 3).choose 3) := by rw [h3]
    _ = 9 * (n.choose 6 * Nat.choose 6 3) := by rw [h1]
    _ = 30 * (n.choose 6 * 6) := by
        rw [show Nat.choose 6 3 = 20 from rfl]
        ring
