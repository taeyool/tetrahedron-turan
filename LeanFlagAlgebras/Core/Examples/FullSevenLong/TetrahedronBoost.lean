  set P₀ : ℝ := (G.pairCountInter 0 : ℝ) with hP₀
  set P₁ : ℝ := (G.pairCountInter 1 : ℝ) with hP₁
  set P₂ : ℝ := (G.pairCountInter 2 : ℝ) with hP₂
  set D₀ : ℝ := (pairChoose n 3 3 : ℝ) with hD₀
  set D₁ : ℝ := 30 * (n.choose 5 : ℝ) with hD₁
  set Q : ℝ := ∑ v : Fin n, (G.degree v : ℝ) ^ 2 with hQ
