/-! ## Gram matrices, built from the certificate factors

The factor entries are stored shifted into the naturals: signed numeral
literals cost far more to elaborate than natural ones, and there are tens
of thousands of them here. -/

/-- The shift applied to every stored factor entry. -/
def factorShift : ℤ := 10597207

/-- Recover the factor array from its shifted storage. -/
def unshift (raw : List ℕ) : Array ℤ :=
  (raw.map fun n => (n : ℤ) - factorShift).toArray

/-- The Gram matrix of a factor family stored row-major, flattened. -/
def gramFromFlat (dim nrows : ℕ) (a : Array ℤ) : Array ℤ :=
  ((List.range dim).flatMap fun i =>
    (List.range dim).map fun j =>
      (List.range nrows).foldl
        (fun s r => s + a.getD (r * dim + i) 0 * a.getD (r * dim + j) 0)
        0).toArray

-- Factor tables are imported from the three generated data modules.

def gram7s1 : Array ℤ := gramFromFlat 7 7 (unshift f7s1Raw)
def gram7s30 : Array ℤ := gramFromFlat 236 236 (unshift f7s30Raw)
def gram7s31 : Array ℤ := gramFromFlat 191 187 (unshift f7s31Raw)

/-! ## Class index of an arbitrary six-vertex mask -/

/-- Mask to representative index, filled by spreading each representative
over its orbit; `9999` marks a mask that is not tetrahedron-free. -/
def classIdxTable : Array ℕ :=
  (h6Reps.foldl (fun (p : Array ℕ × ℕ) h =>
      ((List.range 720).foldl (fun arr k => arr.set! (rankApply (getRank k) h) p.2)
        p.1, p.2 + 1))
    ((List.replicate 1048576 9999).toArray, 0)).1

/-! ## The column value -/

/-! The sample tables are held as arrays: a column walks them millions of
times, and array traversal keeps the inner loop free of pointer
chasing. -/

def deckGathersA : Array ℕ := deckGathers.toArray
def s1GathersA : Array (ℕ × ℕ) := s1Gathers.toArray
def s3RootBitsA : Array ℕ := s3RootBits.toArray
def s3FlatA : Array ℕ := s3Flat.toArray

def deckValue (m : ℕ) : ℤ :=
  deckGathersA.foldl (fun acc g =>
    acc + classNums.getD (classIdxTable.getD (gatherBits g 20 m) 9999) 0) 0

def s1Value (m : ℕ) : ℤ :=
  s1GathersA.foldl (fun acc p =>
    let i := s1IdxT.getD (gatherBits p.1 4 m) 999
    let j := s1IdxT.getD (gatherBits p.2 4 m) 999
    acc + gram7s1.getD (i * 7 + j) 0) 0

/-- The root-triple form at one rooting. The six flag indices are read
once and paired with their complements, so each induced mask is gathered
a single time rather than once per side of a split. -/
def s3RootValue (m base : ℕ) (edgeRoot : Bool) : ℤ :=
  let idx : ℕ → ℕ := fun k =>
    let g := gatherBits (s3FlatA.getD (base + k) 0) 10 m
    if edgeRoot then s3Idx1T.getD g 999 else s3Idx0T.getD g 999
  let i0 := idx 0
  let i1 := idx 1
  let i2 := idx 2
  let i3 := idx 3
  let i4 := idx 4
  let i5 := idx 5
  let d := if edgeRoot then 191 else 236
  let q := if edgeRoot then gram7s31 else gram7s30
  q.getD (i0 * d + i5) 0 + q.getD (i1 * d + i4) 0 + q.getD (i2 * d + i3) 0
    + q.getD (i3 * d + i2) 0 + q.getD (i4 * d + i1) 0 + q.getD (i5 * d + i0) 0

def s3ValueAux (m : ℕ) : ℕ → ℤ → ℤ
  | 0, acc => acc
  | r + 1, acc =>
      s3ValueAux m r
        (acc + s3RootValue m (6 * r) (m.testBit (s3RootBitsA.getD r 0)))

def s3Value (m : ℕ) : ℤ := s3ValueAux m 210 0

/-- **The certificate value of a seven-vertex column**, over the common
denominator `5040 * certScale ^ 2`. -/
def columnValue (m : ℕ) : ℤ :=
  deckValue m + 36 * s1Value m + 4 * s3Value m + s5ColumnNum m

/-- The bound the certificate claims for every column. -/
def columnBound : ℤ := 11245394264033484

/-- A column recorded by the certificate as attaining the maximum. -/
def exampleColumn : ℕ := 4840262484

/-- **The recorded maximizing column evaluates to the recorded bound.**
This pins every convention in the arithmetic at once: the class numbers,
the two order-7 Gram matrices, the sampling weights, and the gathers. -/
lemma columnValue_example : columnValue exampleColumn = columnBound := by
  native_decide

