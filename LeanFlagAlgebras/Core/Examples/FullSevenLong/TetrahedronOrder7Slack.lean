  obtain ⟨i⟩ := (Sym3Graph.isIso_iff_nonempty_modelIso _ _).mp hiso
  refine ⟨e, TetraFree.mem_iso i hG, ?_, hle⟩
  exact (Sym3Graph.toFlag_eq_toFlag_iff _ hG).mpr hiso.symm

