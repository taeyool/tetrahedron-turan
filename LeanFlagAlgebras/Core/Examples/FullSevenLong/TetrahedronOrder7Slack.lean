/-- Every seven-vertex flag class has a mask representative whose
certificate column obeys the bound. -/
theorem exists_bounded_rep (H : FlagWithSize TetraFree emptyType 7) :
    ∃ e : ℕ, ∃ he : TetraFree.Mem (graphOfMask 7 e).toModel,
      (graphOfMask 7 e).toFlag he = H ∧ columnValue e ≤ columnBound := by
