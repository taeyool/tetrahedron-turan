six-vertex class is the fraction of decks lying in it. -/
theorem subflagDensity_deckClass {m : ℕ}
    (hk4 : k4FreeMask (quadIdxList 7) m = true)
    (hm : TetraFree.Mem (graphOfMask 7 m).toModel)
    (H : FlagWithSize TetraFree emptyType 6) :
    subflagDensity H ((graphOfMask 7 m).toFlag hm)
