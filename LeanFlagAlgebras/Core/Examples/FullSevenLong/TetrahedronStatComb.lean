      fun H => decide (TetraFree.Mem H.toModel)) :
    gamma5C H = (H.pairCountInter 1 : ℚ) / 30 := by
  have := List.all_eq_true.mp gamma5C_check H hH
  simpa using this

/-! ## List-sum bookkeeping -/

private lemma pmap_sum_eq {α β : Type} [AddCommMonoid β] {p : α → Prop}
    (f : (a : α) → p a → β) (c : α → β)
    (hfc : ∀ a ha, f a ha = c a) :
    ∀ (l : List α) (H : ∀ a ∈ l, p a),
      (l.pmap f H).sum = (l.map c).sum := by
  intro l
  induction l with
  | nil => intro H; rfl
  | cons a t ih =>
    intro H
    rw [List.pmap, List.map, List.sum_cons, List.sum_cons, hfc, ih]

private lemma cast_list_sum :
    ∀ l : List ℚ, ((l.sum : ℚ) : ℝ)
      = (l.map fun q : ℚ => (q : ℝ)).sum := by
  intro l
  induction l with
  | nil => simp
  | cons a t ih =>
    rw [List.map, List.sum_cons, List.sum_cons, Rat.cast_add, ih]

private lemma list_sum_map_div {α : Type} (g : α → ℕ) (d : ℚ) :
    ∀ L : List α,
      (L.map fun a => ((g a : ℚ)) / d).sum
        = (((L.map g).sum : ℕ) : ℚ) / d := by
  intro L
  induction L with
  | nil => simp
  | cons a l ih =>
    rw [List.map_cons, List.sum_cons, ih, List.map_cons, List.sum_cons]
    push_cast
    ring

/-! ## The five-vertex average collapses to `P₁` -/

/-- The five-vertex class average on a literal host, transported to the
representative listing — `statSum_eq` at an arbitrary size. -/
lemma statSum_eq_host {n : ℕ} (G : Sym3Graph n)
    (hG : TetraFree.Mem G.toModel) :
    (∑ H₅ : FlagWithSize TetraFree emptyType 5,
        degGamma5 H₅ * ((subflagDensity H₅ (G.toFlag hG) : ℚ) : ℝ))
      = (((((sym3Reps 5).filter fun H =>
            decide (TetraFree.Mem H.toModel)).map
          fun H₅ => gamma5C H₅
            * ((H₅.flagCountC G : ℚ) / (n.choose 5 : ℚ))).sum : ℚ) : ℝ) := by
  rw [sum_flag_eq_sum_sym3FlagReps TetraFree
    (fun M (hM : TetraFree.Mem M) => hM.1)
    (fun H₅ => degGamma5 H₅
      * ((subflagDensity H₅ (G.toFlag hG) : ℚ) : ℝ)),
    sym3FlagReps, List.map_pmap]
  rw [pmap_sum_eq _
    (fun H₅ => ((gamma5C H₅
      * ((H₅.flagCountC G : ℚ) / (n.choose 5 : ℚ)) : ℚ) : ℝ)) ?_ _ _]
  · rw [cast_list_sum, List.map_map]
    rfl
  · intro H₅ hH₅
    rw [degGamma5_eq_gamma5C hH₅,
      Sym3Graph.subflagDensity_toFlag hH₅ hG]
    push_cast
    ring

/-- **The five-vertex average is the `P₁` count over its normalizer**:
each listed coefficient is the local pair count over `30`, and the
representative sum collapses by the union fibration. -/
lemma statSum_eq_pairCount {n : ℕ} (G : Sym3Graph n)
    (hG : TetraFree.Mem G.toModel) :
    (∑ H₅ : FlagWithSize TetraFree emptyType 5,
        degGamma5 H₅ * ((subflagDensity H₅ (G.toFlag hG) : ℚ) : ℝ))
      = (((G.pairCountInter 1 : ℚ) / (30 * (n.choose 5 : ℚ)) : ℚ) : ℝ) := by
  rw [statSum_eq_host G hG]
  have hterm : ∀ H₅ ∈ (sym3Reps 5).filter
      fun H => decide (TetraFree.Mem H.toModel),
      gamma5C H₅ * ((H₅.flagCountC G : ℚ) / (n.choose 5 : ℚ))
        = ((H₅.pairCountInter 1 * H₅.flagCountC G : ℕ) : ℚ)
            / (30 * (n.choose 5 : ℚ)) := by
    intro H₅ hH₅
    rw [gamma5C_eq_of_mem hH₅]
    push_cast
    ring
  rw [List.map_congr_left hterm,
    list_sum_map_div
      (fun H₅ : Sym3Graph 5 => H₅.pairCountInter 1 * H₅.flagCountC G)
      (30 * (n.choose 5 : ℚ)),
    Sym3Graph.sum_reps_pairCountInter G hG (by norm_num : 1 + 5 = 6)]

/-! ## The stationarity combination as the explicit class sum -/

/-- The explicit stationarity vector's coefficient at a six-vertex
class: `statNum/180`. -/
lemma statVec_apply (H : FlagWithSize TetraFree emptyType 6) :
    statVec ⟨6, H⟩ = ((statNumOf H / 180 : ℚ) : ℝ) := by
  rw [statVec, Finsupp.smul_apply, Finsupp.finset_sum_apply]
  have hother : ∀ H' : FlagWithSize TetraFree emptyType 6,
      H' ∈ (Finset.univ : Finset (FlagWithSize TetraFree emptyType 6)) →
      H' ≠ H →
      (((statNumOf H' / 60 : ℚ) : ℝ) • basisVector
        (⟨6, H'⟩ : FinFlag TetraFree emptyType)) ⟨6, H⟩ = 0 := by
    intro H' _ hne
    have hne' : (⟨6, H'⟩ : FinFlag TetraFree emptyType) ≠ ⟨6, H⟩ :=
      fun heq => hne (by simpa using heq)
    rw [Finsupp.smul_apply, basisVector_apply_other _ _ hne', smul_zero]
  rw [Finset.sum_eq_single H hother
      (fun h => absurd (Finset.mem_univ H) h),
    Finsupp.smul_apply, basisVector_apply_self]
  simp only [smul_eq_mul, mul_one]
  push_cast
  ring

/-- The stationarity combination is the coefficient sum over all
six-vertex classes. -/
lemma statComb_eq_sum6 {n : ℕ} (G : FlagWithSize TetraFree emptyType n) :
    statComb ⟨n, G⟩
      = ∑ H : FlagWithSize TetraFree emptyType 6,
          ((statNumOf H / 180 : ℚ) : ℝ)
            * ((subflagDensity H G : ℚ) : ℝ) := by
  classical
  show ∑ F ∈ statVec.support,
      statVec F * ((subflagDensity F.2 G : ℚ) : ℝ) = _
  have hsub : statVec.support ⊆
      (Finset.univ : Finset (FlagWithSize TetraFree emptyType 6)).image
        (fun H => (⟨6, H⟩ : FinFlag TetraFree emptyType)) := by
    intro F hF
    by_contra hFim
    refine Finsupp.mem_support_iff.mp hF ?_
    rw [statVec, Finsupp.smul_apply, Finsupp.finset_sum_apply]
    have h0 : ∀ H ∈ (Finset.univ :
        Finset (FlagWithSize TetraFree emptyType 6)),
        (((statNumOf H / 60 : ℚ) : ℝ) • basisVector
          (⟨6, H⟩ : FinFlag TetraFree emptyType)) F = 0 := by
      intro H _
      have hne : (⟨6, H⟩ : FinFlag TetraFree emptyType) ≠ F :=
        fun heq => hFim (Finset.mem_image.mpr ⟨H, Finset.mem_univ H, heq⟩)
      rw [Finsupp.smul_apply, basisVector_apply_other _ _ hne, smul_zero]
    rw [Finset.sum_eq_zero h0, smul_zero]
  rw [Finset.sum_subset hsub (fun F _ hF => by
      have h0 : statVec F = 0 := by
        by_contra h
        exact hF (Finsupp.mem_support_iff.mpr h)
      rw [h0, zero_mul]),
    Finset.sum_image (fun H _ H' _ heq => by
      injection heq with h1 h2)]
  exact Finset.sum_congr rfl fun H _ => by rw [statVec_apply]

/-! ## The coefficient identity, and the chain rules -/

/-- The six-vertex coefficient, read off the certificate check: the
stationarity numerator over `180` is the edge pair density minus the
five-vertex average. -/
lemma statNum_coeff_eq (H : FlagWithSize TetraFree emptyType 6) :
    ((statNumOf H / 180 : ℚ) : ℝ)
      = ((subflagPairDensity (edgeGraph.toFlag edgeGraph_mem)
            (edgeGraph.toFlag edgeGraph_mem) H : ℚ) : ℝ)
        - ∑ H₅ : FlagWithSize TetraFree emptyType 5,
            degGamma5 H₅ * ((subflagDensity H₅ H : ℚ) : ℝ) := by
  have hcoeff : ((subflagPairDensity (edgeGraph.toFlag edgeGraph_mem)
        (edgeGraph.toFlag edgeGraph_mem) H : ℚ) : ℝ)
      - ∑ H₅ : FlagWithSize TetraFree emptyType 5,
          degGamma5 H₅ * ((subflagDensity H₅ H : ℚ) : ℝ)
      = ((statCoeffC (graphOfMask 6 (repMask H)) : ℚ) : ℝ) := by
    conv_lhs => rw [← toFlag_repMask H (repMask_memT H)]
    exact stationarity_coeff_eq (graphOfMask 6 (repMask H)) (repMask_memT H)
  rw [hcoeff]
  have hnum : (statNumOf H / 180 : ℚ)
      = statCoeffC (graphOfMask 6 (repMask H)) := by
    have h1 : statNumOf H = statNum (repMask H) := rfl
    have h2 := statNum_eq_of_mem (repMask_mem H)
    rw [h1, h2]
    ring
  exact_mod_cast hnum

/-- **The stationarity combination chains to the host** (Razborov's
Lemma 2.2): on any flag of size at least six, `statComb` is exactly the
edge pair density minus the five-vertex average, evaluated directly on
the host — the identity is exact at every finite size, not just in the
limit. -/
theorem statComb_eq_host {n : ℕ} (G : FlagWithSize TetraFree emptyType n)
    (hn : 6 ≤ n) :
    statComb ⟨n, G⟩
      = ((subflagPairDensity (edgeGraph.toFlag edgeGraph_mem)
            (edgeGraph.toFlag edgeGraph_mem) G : ℚ) : ℝ)
        - ∑ H₅ : FlagWithSize TetraFree emptyType 5,
            degGamma5 H₅ * ((subflagDensity H₅ G : ℚ) : ℝ) := by
  have hCR1 : ((subflagPairDensity (edgeGraph.toFlag edgeGraph_mem)
        (edgeGraph.toFlag edgeGraph_mem) G : ℚ) : ℝ)
      = ∑ H : FlagWithSize TetraFree emptyType 6,
          ((subflagPairDensity (edgeGraph.toFlag edgeGraph_mem)
              (edgeGraph.toFlag edgeGraph_mem) H : ℚ) : ℝ)
            * ((subflagDensity H G : ℚ) : ℝ) := by
    rw [subflagPairDensity_chain_host (W' := Fin 6) (by simp)
      (by simpa using hn) (edgeGraph.toFlag edgeGraph_mem)
      (edgeGraph.toFlag edgeGraph_mem) G]
    push_cast
    rfl
  have hCR2 : ∀ H₅ : FlagWithSize TetraFree emptyType 5,
      ((subflagDensity H₅ G : ℚ) : ℝ)
        = ∑ H : FlagWithSize TetraFree emptyType 6,
            ((subflagDensity H₅ H : ℚ) : ℝ)
              * ((subflagDensity H G : ℚ) : ℝ) := by
    intro H₅
    rw [subflagDensity_chain (W' := Fin 6) (by simp)
      (by simpa using hn) H₅ G]
    push_cast
    rfl
  have hsubst : ∑ H : FlagWithSize TetraFree emptyType 6,
      ((statNumOf H / 180 : ℚ) : ℝ) * ((subflagDensity H G : ℚ) : ℝ)
      = ∑ H : FlagWithSize TetraFree emptyType 6,
          (((subflagPairDensity (edgeGraph.toFlag edgeGraph_mem)
                (edgeGraph.toFlag edgeGraph_mem) H : ℚ) : ℝ)
              * ((subflagDensity H G : ℚ) : ℝ)
            - (∑ H₅ : FlagWithSize TetraFree emptyType 5,
                degGamma5 H₅ * ((subflagDensity H₅ H : ℚ) : ℝ))
              * ((subflagDensity H G : ℚ) : ℝ)) :=
    Finset.sum_congr rfl fun H _ => by
      rw [statNum_coeff_eq H, sub_mul]
  have hswap : ∑ H : FlagWithSize TetraFree emptyType 6,
      (∑ H₅ : FlagWithSize TetraFree emptyType 5,
        degGamma5 H₅ * ((subflagDensity H₅ H : ℚ) : ℝ))
        * ((subflagDensity H G : ℚ) : ℝ)
      = ∑ H₅ : FlagWithSize TetraFree emptyType 5,
          degGamma5 H₅ * ((subflagDensity H₅ G : ℚ) : ℝ) := by
    have h1 : ∀ H : FlagWithSize TetraFree emptyType 6,
        (∑ H₅ : FlagWithSize TetraFree emptyType 5,
          degGamma5 H₅ * ((subflagDensity H₅ H : ℚ) : ℝ))
          * ((subflagDensity H G : ℚ) : ℝ)
        = ∑ H₅ : FlagWithSize TetraFree emptyType 5,
            degGamma5 H₅ * (((subflagDensity H₅ H : ℚ) : ℝ)
              * ((subflagDensity H G : ℚ) : ℝ)) := by
      intro H
      rw [Finset.sum_mul]
      exact Finset.sum_congr rfl fun H₅ _ => by ring
    rw [Finset.sum_congr rfl fun H _ => h1 H, Finset.sum_comm]
    refine Finset.sum_congr rfl fun H₅ _ => ?_
    rw [← Finset.mul_sum, ← hCR2 H₅]
  rw [statComb_eq_sum6 G, hsubst, Finset.sum_sub_distrib, ← hCR1, hswap]

/-- **The stationarity combination as pattern counts**: on a literal
tetrahedron-free host of size at least six,

  `statComb = P₀ / (C(n,3)·C(n-3,3)) − P₁ / (30·C(n,5))`,

where `P₀` counts ordered pairs of disjoint hyperedges and `P₁` ordered
pairs meeting in one vertex. Together with `sum_degree_sq` this reads
the stationarity combination as an empirical degree statistic — the
finite input of the boost argument. -/
theorem statComb_toFlag_eq {n : ℕ} (G : Sym3Graph n)
    (hG : TetraFree.Mem G.toModel) (hn : 6 ≤ n) :
    statComb ⟨n, G.toFlag hG⟩
      = (G.pairCountInter 0 : ℝ) / (pairChoose n 3 3 : ℝ)
        - (G.pairCountInter 1 : ℝ) / (30 * (n.choose 5 : ℝ)) := by
  rw [statComb_eq_host (G.toFlag hG) hn, statSum_eq_pairCount G hG,
    Sym3Graph.subflagPairDensity_toFlag edgeGraph_mem edgeGraph_mem hG,
    ← pairCountInter_zero_eq]
  push_cast
  ring

