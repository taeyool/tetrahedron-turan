        ⟨Finset.subset_univ _, G.edges_valid _ hm.2⟩⟩
  · rintro ⟨e, f⟩ hq
    obtain ⟨hmem, hc⟩ := Finset.mem_filter.mp hq
    have hm := Finset.mem_product.mp hmem
    refine Finset.mem_filter.mpr ⟨Finset.mem_attach _ _, ?_, ?_, ?_⟩
    · exact Finset.disjoint_iff_inter_eq_empty.mpr
