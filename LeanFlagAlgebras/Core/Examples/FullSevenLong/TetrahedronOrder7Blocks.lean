/-- Vertex `i` of a packed vertex list (three bits per entry). -/
def vertAt (vs i : ℕ) : ℕ := (vs >>> (3 * i)) &&& 7

/-- Triples of a four-vertex flag: source indices and target bit. -/
def tri4 : List (ℕ × ℕ × ℕ × ℕ) := [(0, 1, 2, 0), (0, 1, 3, 1), (0, 2, 3, 2), (1, 2, 3, 3)]

/-- Triples of a five-vertex flag. -/
def tri5 : List (ℕ × ℕ × ℕ × ℕ) :=
  [(0, 1, 2, 0), (0, 1, 3, 1), (0, 1, 4, 2), (0, 2, 3, 3), (0, 2, 4, 4), (0, 3, 4, 5), (1, 2, 3, 6), (1, 2, 4, 7), (1, 3, 4, 8), (2, 3, 4, 9)]

/-- The mask induced on a packed vertex list by a six-vertex mask. -/
def inducedFrom (tbl : List (ℕ × ℕ × ℕ × ℕ)) (m vs : ℕ) : ℕ :=
  tbl.foldl (fun acc t =>
    let s := sort3 (vertAt vs t.1) (vertAt vs t.2.1) (vertAt vs t.2.2.1)
    if m.testBit (triIdx 6 s.1 s.2.1 s.2.2) then acc ||| (1 <<< t.2.2.2)
    else acc) 0

/-- Inverse table of a flag list: mask to index, `999` when absent. -/
def invOf (size : ℕ) (flags : List ℕ) : Array ℕ :=
  (flags.foldl (fun (p : Array ℕ × ℕ) m => (p.1.set! m p.2, p.2 + 1))
    ((List.replicate size 999).toArray, 0)).1

