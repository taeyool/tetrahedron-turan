/-! ## Evaluation -/

/-- Sum of `a i * a j` over the factor rows of a block. -/
def formAt (fs : List (Array ℤ)) (i j : ℕ) : ℤ :=
  fs.foldl (fun acc a => acc + a.getD i 0 * a.getD j 0) 0

/-- The four-root blocks, dispatched by the mask the roots induce. -/
def blockValue45 (h : ℕ) : ℤ :=
  splits45.foldl (fun acc p =>
    let rm := inducedFrom tri4 h p.1
    let mA := inducedFrom tri5 h p.1
    let mB := inducedFrom tri5 h p.2
    match rm with
    | 0 => acc + formAt facs45_0 (inv45_0.getD mA 999) (inv45_0.getD mB 999)
    | 1 => acc + formAt facs45_1 (inv45_1.getD mA 999) (inv45_1.getD mB 999)
    | 3 => acc + formAt facs45_3 (inv45_3.getD mA 999) (inv45_3.getD mB 999)
    | 7 => acc + formAt facs45_7 (inv45_7.getD mA 999) (inv45_7.getD mB 999)
    | _ => acc) 0

/-- The two-root block. Its flags are canonical up to swapping the two
non-root vertices, so the induced mask is canonicalized before lookup. -/
def canon24 (m : ℕ) : ℕ :=
  let sw := (if m.testBit 0 then 2 else 0) ||| (if m.testBit 1 then 1 else 0)
    ||| (if m.testBit 2 then 4 else 0) ||| (if m.testBit 3 then 8 else 0)
  min m sw

def blockValue24 (h : ℕ) : ℤ :=
  splits24.foldl (fun acc p =>
    let mA := canon24 (inducedFrom tri4 h p.1)
    let mB := canon24 (inducedFrom tri4 h p.2)
    acc + formAt facs24 (inv24.getD mA 999) (inv24.getD mB 999)) 0

